#======================
# Custom URScripts
#======================
record(lso, "$(P)Control:CustomScriptFile")
{
    field(DESC, "Path to URScript")
    field(DTYP, "asynOctetWrite")
    field(SIZV, 1024)
    field(OUT,  "@asyn($(PORT),0,$(TIMEOUT=1))CUSTOM_SCRIPT_FILE")
}

record(lso, "$(P)Control:CustomInlineScript")
{
    field(DESC, "Inline URScript")
    field(DTYP, "asynOctetWrite")
    field(SIZV, 1024)
    field(OUT,  "@asyn($(PORT),0,$(TIMEOUT=1))CUSTOM_INLINE_SCRIPT")
}

record(bo, "$(P)Control:RunCustomScriptFile")
{
    field(DESC, "Runs custom URScript on controller")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,$(TIMEOUT=1))RUN_CUSTOM_SCRIPT_FILE")
}

record(ao, "$(P)Control:CustomScriptTimeout")
{
    field(DESC, "Timeout for script to signal done")
    field(DTYP, "asynFloat64")
    field(VAL, 10.0)
    field(EGU, "sec")
    field(PINI, 1)
    field(OUT,  "@asyn($(PORT),0,$(TIMEOUT=1))CUSTOM_SCRIPT_TIMEOUT")
}

record(bi, "$(P)Control:CustomScriptRunning")
{
    field(DESC, "1 if custom script running, else 0")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))CUSTOM_SCRIPT_RUNNING")
    field(ZNAM, "Done")
    field(ONAM, "Running")
    field(SCAN, "I/O Intr")
}

record(bi, "$(P)Control:CustomScriptError")
{
    field(DESC, "0 if okay, 1 if script error")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))CUSTOM_SCRIPT_ERROR")
    field(ZNAM, "Okay")
    field(ONAM, "Error")
    field(SCAN, "I/O Intr")
}

#======================
# Contact Detection
#======================

record(bo, "$(P)Control:StartContactDetect")
{
    field(DESC, "Starts contact detection")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1)START_CONTACT")
}

record(bo, "$(P)Control:StopContactDetect")
{
    field(DESC, "Stops contact detection")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),0,1)STOP_CONTACT")
}

record(bi, "$(P)Control:ReadContactDetect")
{
    field(DESC, "1 if contact detected")
    field(DTYP, "asynInt32")
    field(INP,  "@asyn($(PORT),0,1)READ_CONTACT")
    field(SCAN, "I/O Intr")
}

record(ao, "$(P)Control:ContactTimeout") {
    field(EGU, "sec")
    field(VAL, 10.0)
    field(PREC, 1)
}

record(seq, "$(P)Control:sync_contact_target")
{
    field(PINI, 1)
    field(DLY0, 1)

    field(DOL0, "$(P)Receive:PoseX")
    field(LNK0, "$(P)Control:ContactTargetX PP")

    field(DOL1, "$(P)Receive:PoseY")
    field(LNK1, "$(P)Control:ContactTargetY PP")

    field(DOL2, "$(P)Receive:PoseZ")
    field(LNK2, "$(P)Control:ContactTargetZ PP")

    field(DOL3, "$(P)Receive:PoseRx")
    field(LNK3, "$(P)Control:ContactTargetRx PP")

    field(DOL4, "$(P)Receive:PoseRy")
    field(LNK4, "$(P)Control:ContactTargetRy PP")

    field(DOL5, "$(P)Receive:PoseRz")
    field(LNK5, "$(P)Control:ContactTargetRz PP")
}

record(ao, "$(P)Control:ContactTargetX") {
    field(EGU, "mm")
    field(PREC, 3)
}
record(ao, "$(P)Control:ContactTargetY") {
    field(EGU, "mm")
    field(PREC, 3)
}
record(ao, "$(P)Control:ContactTargetZ") {
    field(EGU, "mm")
    field(PREC, 3)
}
record(ao, "$(P)Control:ContactTargetRx") {
    field(EGU, "mm")
    field(PREC, 3)
}
record(ao, "$(P)Control:ContactTargetRy") {
    field(EGU, "mm")
    field(PREC, 3)
}
record(ao, "$(P)Control:ContactTargetRz") {
    field(EGU, "mm")
    field(PREC, 3)
}

record(mbbi, "$(P)Control:ContactError") {
    field(ZRVL, 0)
    field(ONVL, 1)
    field(TWVL, 2)
    field(ZRST, "")
    field(ONST, "Error")
    field(TWST, "Stopped")
}

record(waveform, "$(P)Control:ContactPose") {
    field(FTVL, "DOUBLE")
    field(NELM, 6)
    field(INP, "$(P)Receive:ActualTCPPose.VAL")
    field(PREC, 3)
}

record(busy, "$(P)Control:MoveUntilContact")
{
    field(OUT, "$(P)Control:trigger_muc.A PP")
}

record(calcout, "$(P)Control:trigger_muc") {
    field(CALC, "A==1")
    field(OOPT, "When Non-zero")
    field(OUT, "$(P)Control:lua_muc.PROC")
}

record(luascript, "$(P)Control:lua_muc")
{
    field(DESC, "Move until contact")
    field(INPA, "$(P)Control:ContactTargetX")
    field(INPB, "$(P)Control:ContactTargetY")
    field(INPC, "$(P)Control:ContactTargetZ")
    field(INPD, "$(P)Control:ContactTargetRx")
    field(INPE, "$(P)Control:ContactTargetRy")
    field(INPF, "$(P)Control:ContactTargetRz")
    field(INPG, "$(P)Control:ContactTimeout")
    field(SYNC, "Async")
    field(CODE, "@contact.lua muc({P='$(P)'})")
}
