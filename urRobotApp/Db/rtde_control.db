#======================
# TCP pose control
#======================

record(busy, "$(P)Control:moveL")
{
    field(DESC, "Move to TCP pose linearly")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))MOVEL")
}


record(ao, "$(P)Control:LinearSpeed")
{
    field(DESC, "Linear speed for moveL")
    field(DTYP, "asynFloat64")
    field(PREC, 3)
    field(VAL, 100.0)
    field(EGU, "mm/s")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))LINEAR_SPEED")
}

record(ao, "$(P)Control:LinearAcceleration")
{
    field(DESC, "Linear acceleration for moveL")
    field(DTYP, "asynFloat64")
    field(PREC, 3)
    field(VAL, 200.0)
    field(EGU, "mm/s/s")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))LINEAR_ACCELERATION")
}

record(ao, "$(P)Control:LinearBlend")
{
    field(DESC, "Linear blend for moveL paths")
    field(DTYP, "asynFloat64")
    field(PREC, 3)
    field(EGU, "mm")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))LINEAR_BLEND")
}

record(bo, "$(P)Control:stopL")
{
    field(DESC, "Stop linear move to TCP pose")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR=0),$(TIMEOUT=1))STOPL")
    field(FLNK, "$(P)Control:sync_both_cmd.PROC")
}

record(bo, "$(P)Control:syncing_pose") {}

record(calcout, "$(P)Control:moveL_if_not_syncing") {
    field(INPA, "$(P)Control:syncing_pose")
    field(CALC, "A==0")
    field(OOPT, "When Non-zero")
    field(OUT, "$(P)Control:moveL.PROC")
}

record(sseq, "$(P)Control:sync_pose_cmd")
{
    field(PINI, 0)

    field(LNK1, "$(P)Control:syncing_pose.VAL CA")
    field(STR1, "1")

    field(DOL2, "$(P)Receive:PoseX")
    field(LNK2, "$(P)Control:PoseXCmdU CA")
    field(WAIT2, "After1")

    field(DOL3, "$(P)Receive:PoseY")
    field(LNK3, "$(P)Control:PoseYCmdU CA")
    field(WAIT3, "After1")

    field(DOL4, "$(P)Receive:PoseZ")
    field(LNK4, "$(P)Control:PoseZCmdU CA")
    field(WAIT4, "After1")

    field(DOL5, "$(P)Receive:PoseRx")
    field(LNK5, "$(P)Control:PoseRxCmd CA")
    field(WAIT5, "After1")

    field(DOL6, "$(P)Receive:PoseRy")
    field(LNK6, "$(P)Control:PoseRyCmd CA")
    field(WAIT6, "After1")

    field(DOL7, "$(P)Receive:PoseRz")
    field(LNK7, "$(P)Control:PoseRzCmd CA")
    field(WAIT7, "After1")

    field(LNK8, "$(P)Control:syncing_pose.VAL CA")
    field(STR8, "0")
    field(WAIT8, "After7")
}

# -----------------------------------------------------------

record(ao, "$(P)Control:PoseXCmd")
{
    field(DESC, "Commanded TCP X")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),0,$(TIMEOUT=1))POSE_CMD")
    field(EGU, "mm")
    field(PINI, 1)
    field(PREC, 4)
}
