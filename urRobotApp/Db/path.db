record(stringout, "$(P)Path$(N)") {
    field(DESC,"Description of path")
    field(VAL, "$(DESC=Path $(N))")
}

record(bo, "$(P)Path$(N):Go") {
    field(ZNAM, "Idle")
    field(ONAM, "Go")
}
